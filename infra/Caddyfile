mobilelens.duckdns.org {
    request_body {
        max_size 350MB
    }

    # Pliki (zdjęcia, filmy, miniatury) serwowane prosto z dysku, bez udziału API.
    # Nazwy plików to UUID-y, więc można je cache'ować "na zawsze".
    handle_path /media/* {
        root * /srv/media/files
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options "nosniff"
        header Content-Security-Policy "default-src 'none'"
        file_server
    }

    handle {
        reverse_proxy api:3000
    }
}
